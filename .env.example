# Copy this file to `.env` and change it. Never commit `.env` (it is in .gitignore).
# Every value can also be set as a normal environment variable.

# docker compose: the image to pull. CI publishes ghcr.io/<owner>/<repo> (lower case).
# HERON_IMAGE=ghcr.io/<your-github-user>/heron

# Store the verdicts in this SQLite file (unset = do not store them)
HERON_DB=verdicts.db

# DEBUG, INFO, WARNING or ERROR
HERON_LOG_LEVEL=INFO

# From Module 8 on: your own free key from Google AI Studio (no billing account)
# GEMINI_API_KEY=
